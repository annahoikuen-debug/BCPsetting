# ============================================================
# セキュリティに関する重要な注意事項
# ------------------------------------------------------------
# - このファイルは .env のテンプレートです。
# - .env ファイルは .gitignore によりバージョン管理から除外されます。
# - 実際のAPIキーや秘密情報を .env に設定し、絶対にコミットしないでください。
# - 本番環境では、環境変数またはシークレットマネージャー（AWS Secrets Manager等）
#   からAPIキーを供給することを強く推奨します。
# ============================================================

GEMINI_API_KEY=your_gemini_api_key_here
STABLE_DIFFUSION_API_KEY=your_sd_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
APP_API_KEYS=default_key_change_me_in_production,key2,key3

# CORS オリジン（カンマ区切り）。本番環境では具体的なドメインを指定してください。
CORS_ORIGINS=

# S3 Config (Optional for Phase 1)
S3_BUCKET=webtoon-assets
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
