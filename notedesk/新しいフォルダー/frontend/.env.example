# ============================================================
# セキュリティに関する重要な注意事項
# ------------------------------------------------------------
# - NEXT_PUBLIC_ で始まる変数はブラウザに公開されます。
# - APIキーなどの秘密情報をここに含めないでください。
# - 秘密情報はバックエンド側で環境変数として管理し、
#   フロントエンドはセッショントークン等のみを扱う設計への移行を検討してください。
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_API_KEY=default_key_change_me_in_production
